# Unity project standard .gitignore
# Designed for Unity, macOS, and Android/Meta Quest development

# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Logs/

# Unity / Android / Gradle artifacts
.utmp/
.gradle/
*.apk
*.aab
*.obb

# Unity asset cache & temporary generated files
sysinfo.txt
*.stackdump

# Visual Studio / VS Code / Rider cache & project solutions
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for deleted files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# IDE directories
.vs/
.idea/
.vscode/

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Logs/AssetImportWorkerHW0.log
Logs/AssetImportWorkerHW1.log
Logs/Editor.log
Logs/shadercompiler-AssetImportWorkerHW0-0.log
Logs/shadercompiler-AssetImportWorkerHW1-0.log
Logs/upm.log
